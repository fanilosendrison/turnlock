{
  "name": "turnlock",
  "version": "0.10.0",
  "description": "Durable finite-state-machine runtime for TypeScript. SQLite-authoritative durable workflow state with fenced ownership, repairable JSON projections, and an in-band stdout protocol. Host-agnostic: suspends by terminating its process and resumes from disk.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs/sqlite-ownership-migration.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "build:tests": "node scripts/build-tests.mjs",
    "test": "pnpm run build:tests && node scripts/run-tests.mjs",
    "test:policy": "node --test scripts/test/bun-policy.test.mjs && node scripts/validate-bun-policy.mjs",
    "test:crash": "pnpm run build:tests && node --test --test-concurrency=1 .test-dist/tests/persistence/bootstrap-crash.integration.test.js .test-dist/tests/engine/orchestrator-projection-crash.test.js",
    "test:tl-f-001-bootstrap-proof": "pnpm run build:tests && node --test --test-concurrency=1 .test-dist/tests/persistence/bootstrap-atomicity.test.js .test-dist/tests/persistence/bootstrap-commit-failure.test.js .test-dist/tests/persistence/bootstrap-crash.integration.test.js .test-dist/tests/persistence/initial-dispatch-marker.test.js .test-dist/tests/engine/orchestrator-projection-crash.test.js",
    "test:node-package": "pnpm run build && tsc -p tests/package/tsconfig.consumer.json && node --test tests/package/node-esm-distribution.node.mjs",
    "lint": "biome check src/ tests/ scripts/",
    "lint:fix": "biome check --write src/ tests/ scripts/",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && pnpm run build && tsc --noEmit -p tests/package/tsconfig.consumer.json",
    "prepack": "pnpm run test:node-package",
    "changelog": "git-cliff --output CHANGELOG.md"
  },
  "dependencies": {
    "ulid": "^2.3.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/node": "^22.19.0",
    "fast-check": "^3.23.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=11.24.0"
  },
  "packageManager": "pnpm@11.24.0",
  "license": "UNLICENSED"
}
