{
  "name": "turnlock",
  "version": "0.10.0",
  "description": "Durable finite-state-machine runtime for TypeScript. SQLite-authoritative durable workflow state with fenced ownership, repairable JSON projections, and an in-band stdout protocol. Host-agnostic: suspends by terminating its process and resumes from disk.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs/sqlite-ownership-migration.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "test:crash": "bun test tests/persistence/bootstrap-crash.integration.test.ts tests/engine/orchestrator-projection-crash.test.ts",
    "test:tl-f-001-bootstrap-proof": "bun test tests/persistence/bootstrap-atomicity.test.ts tests/persistence/bootstrap-commit-failure.test.ts tests/persistence/bootstrap-crash.integration.test.ts tests/persistence/initial-dispatch-marker.test.ts tests/engine/orchestrator-projection-crash.test.ts",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --write src/ tests/",
    "typecheck": "tsc --noEmit",
    "changelog": "git-cliff --output CHANGELOG.md"
  },
  "dependencies": {
    "zod": "^3.22.0",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/bun": "^1.1.0",
    "fast-check": "^3.23.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
